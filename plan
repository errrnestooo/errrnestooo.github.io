<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Plans | Ernest's Journal</title>

  <style>
    :root{
      --bg:#fbf7f0;
      --card:#ffffffcc;
      --text:#1f1f1f;
      --muted:#6b5f54;
      --line:#eadfce;
      --link:#7a4e2d;
      --selected:#f2e7d6;
      --shadow: 0 6px 18px rgba(0,0,0,0.04);
      --danger:#b23b3b;
      --primary:#7a4e2d;
    }
    body{
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,"PingFang SC","Microsoft YaHei",sans-serif;
      max-width:1100px; margin:0 auto; padding:44px 18px;
      background:var(--bg); color:var(--text); line-height:1.75;
    }
    header{ text-align:center; margin-bottom:18px; }
    h1{ margin:0 0 8px 0; font-size:36px; letter-spacing:.2px; }
    .nav{ text-align:center; margin:12px 0 24px; }
    .nav a{
      margin:0 10px; text-decoration:none; color:var(--muted);
      padding:6px 10px; border-radius:10px;
    }
    .nav a:hover{ background:var(--selected); color:var(--link); }
    .nav a.active{ background:var(--selected); color:var(--link); font-weight:600; }

    .wrap{
      background:var(--card); border:1px solid var(--line);
      border-radius:18px; box-shadow:var(--shadow);
      padding:18px;
    }

    .controls{
      display:flex; flex-wrap:wrap; gap:10px;
      align-items:center; justify-content:space-between;
      margin-bottom:12px;
    }
    .controls .left, .controls .right{ display:flex; gap:10px; align-items:center; flex-wrap:wrap; }

    select, button, input, textarea{
      border:1px solid var(--line);
      background:#fff; border-radius:12px;
      padding:8px 10px; font-size:14px;
      outline:none;
    }
    textarea{ resize:vertical; min-height:40px; }
    button{ cursor:pointer; }
    button:hover{ background:var(--selected); }
    button.primary{
      background:var(--primary);
      border-color:var(--primary);
      color:#fff;
    }
    button.primary:hover{ filter:brightness(0.95); background:var(--primary); }
    button.danger{
      border-color:rgba(178,59,59,.35);
      color:var(--danger);
      background:#fff;
    }
    button.danger:hover{ background:rgba(178,59,59,.06); }

    .hint{ color:var(--muted); font-size:13px; margin-top:10px; }
    .small{ color:var(--muted); font-size:13px; }

    .grid2{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:12px;
      margin-top:12px;
    }
    @media (max-width: 900px){
      .grid2{ grid-template-columns: 1fr; }
    }
    .panel{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:18px;
      box-shadow:var(--shadow);
      padding:16px;
    }
    h2{ margin:0 0 10px 0; font-size:20px; }

    .calendar{
      margin-top:10px;
      display:grid;
      grid-template-columns: repeat(7, 1fr);
      gap:8px;
    }
    .dow{
      font-weight:600; color:var(--muted);
      text-align:center; padding:8px 0;
    }
    .cell{
      background:#fff; border:1px solid var(--line);
      border-radius:14px; padding:10px;
      min-height:72px;
      display:flex; flex-direction:column;
      gap:6px;
      cursor:pointer;
      position:relative;
      transition: transform .05s ease, background .15s ease;
    }
    .cell:hover{ background: #fff7ed; }
    .cell:active{ transform: scale(0.99); }
    .cell.muted{ opacity:.45; cursor:default; }
    .cell.muted:hover{ background:#fff; }

    .date{
      font-weight:700;
      display:flex; justify-content:space-between; align-items:center;
      gap:8px;
    }
    .tag{
      font-size:11px; color:var(--link);
      background:var(--selected);
      border:1px solid var(--line);
      padding:2px 8px; border-radius:999px;
      white-space:nowrap;
    }
    .cell.selected{
      background: var(--selected);
      border-color:#d9c7ad;
    }

    .cell.is-ph{
      border-color:#d7b28a;
      background:#fff6e8;
    }
    .ph-tag{
      position:absolute;
      top:10px;
      right:10px;
      font-size:11px;
      padding:2px 8px;
      border-radius:999px;
      border:1px solid #e8c9a6;
      background:#fff;
      color:#7a4e2d;
    }
    .ph-name{
      margin-top: 6px;
      font-size:12px;
      color:#7a4e2d;
      line-height:1.35;
    }

    table{
      width:100%;
      border-collapse:collapse;
      overflow:hidden;
      border-radius:14px;
      border:1px solid var(--line);
      background:#fff;
    }
    th, td{
      padding:10px 12px;
      border-bottom:1px solid var(--line);
      text-align:left;
      font-size:14px;
      vertical-align:top;
    }
    th{ background:#fff7ed; color:#4b3f35; }
    tr:last-child td{ border-bottom:none; }

    .pill{
      display:inline-block;
      padding:2px 8px;
      border:1px solid var(--line);
      border-radius:999px;
      background:#fff;
      color:var(--muted);
      font-size:12px;
      margin-right:6px;
      margin-top:6px;
      white-space:nowrap;
    }
    .pills-wrap{ display:flex; flex-wrap:wrap; gap:6px; }

    .stack{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
    .wide{ width: 320px; max-width: 100%; }
    .full{ width: 100%; }

    .mutebox{
      background:#fff;
      border:1px dashed var(--line);
      border-radius:14px;
      padding:10px 12px;
      color:var(--muted);
      font-size:13px;
    }

    .right-actions{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; justify-content:flex-end; }

    .plan-details { margin-top: 6px; }
    .plan-details summary{
      cursor: pointer;
      list-style: none;
      user-select: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 10px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: #fff;
      color: var(--muted);
      font-size: 12px;
    }
    .plan-details summary::-webkit-details-marker{ display:none; }
    .plan-details summary:hover{ background: var(--selected); }
    .plan-details[open] summary{
      background: var(--selected);
      border-color:#d9c7ad;
      color: var(--link);
    }
    .chev{
      width: 8px; height: 8px;
      border-right: 2px solid var(--muted);
      border-bottom: 2px solid var(--muted);
      transform: rotate(45deg);
      transition: transform .15s ease, border-color .15s ease;
      display:inline-block;
    }
    .plan-details[open] .chev{
      transform: rotate(-135deg);
      border-color: var(--link);
    }
  </style>
</head>

<body>

<header>
  <h1>Plans</h1>
  <div class="nav">
    <a href="index.html">Home</a>
    <a href="diary.html">Diary</a>
    <a href="travel.html">Travel</a>
    <a href="plans.html" class="active">Plans</a>
    <a href="about.html">About</a>
  </div>
</header>

<div class="wrap">
  <div class="controls">
    <div class="left">
      <label class="small">Year</label>
      <select id="yearSelect"></select>

      <label class="small">Month</label>
      <select id="monthSelect"></select>

      <button id="todayBtn">Today</button>
    </div>

    <div class="right">
      <button id="clearMonthBtn">Clear Draft (This Month)</button>
      <button id="clearDraftBtn">Clear Draft (All)</button>
    </div>
  </div>

  <div class="calendar" id="calendar"></div>

  <div class="hint" id="draftHint">
    ✅ 点击日期：加入/取消 Draft 假期。按住 <b>Shift</b>：连续选择区间（先点起点，再 Shift 点终点）。<br/>
    🟧 标记 <b>PH</b> 的为新加坡公假（Public Holiday）。
  </div>
</div>

<div class="grid2">
  <div class="panel">
    <h2>Draft Plan</h2>
    <div class="small">先在日历里选日期（Shift 可连选），再填名称/备注并保存成一条计划。</div>

    <div style="margin-top:12px;" class="stack">
      <input id="planNameInput" class="wide" placeholder="Plan Name（必填）例如：Jordan Trip" />
      <button id="savePlanBtn" class="primary">Save Plan</button>
      <button id="cancelEditBtn" style="display:none;">Cancel Edit</button>
    </div>

    <div style="margin-top:10px;">
      <textarea id="planNoteInput" class="full" placeholder="Note（可选）例如：去哪里、和谁、主题、预算等"></textarea>
    </div>

    <div style="margin-top:10px;" class="mutebox" id="draftPreview">
      Draft 日期：<span class="small">（还没选）</span>
    </div>
  </div>

  <div class="panel">
    <h2>Saved Plans</h2>
    <div class="small">每次保存是一条计划。你可以继续新增、编辑或删除。</div>

    <div style="margin-top:12px; overflow:auto;">
      <table>
        <thead>
          <tr>
            <th style="width:150px;">Name</th>
            <th>Dates</th>
            <th style="width:220px;">Note</th>
            <th style="width:160px;">Actions</th>
          </tr>
        </thead>
        <tbody id="plansBody"></tbody>
      </table>
    </div>
  </div>
</div>

<div class="panel" style="margin-top:16px;">
  <h2>Yearly Summary</h2>
  <div class="small">按年份汇总你所有 Saved Plans 的日期：总天数 + 明细（按 Plan 分组）。</div>

  <div style="margin-top:12px; overflow:auto;">
    <table>
      <thead>
        <tr>
          <th style="width:120px;">Year</th>
          <th style="width:120px;">Days</th>
          <th>Details</th>
        </tr>
      </thead>
      <tbody id="summaryBody"></tbody>
    </table>
  </div>
</div>

<script>
/* =========================
   Singapore Public Holidays
   ========================= */
const SG_PUBLIC_HOLIDAYS = {
  2026: {
    "2026-01-01": "New Year’s Day",
    "2026-02-17": "Chinese New Year (Day 1)",
    "2026-02-18": "Chinese New Year (Day 2)",
    "2026-03-20": "Good Friday",
    "2026-05-01": "Labour Day",
    "2026-05-03": "Hari Raya Puasa",
    "2026-05-24": "Vesak Day",
    "2026-06-27": "Hari Raya Haji",
    "2026-08-09": "National Day",
    "2026-11-08": "Deepavali",
    "2026-12-25": "Christmas Day"
  }
};

function getPublicHolidayLabel(dateObj){
  const y = dateObj.getFullYear();
  const m = String(dateObj.getMonth()+1).padStart(2, "0");
  const d = String(dateObj.getDate()).padStart(2, "0");
  const key = `${y}-${m}-${d}`;
  const map = SG_PUBLIC_HOLIDAYS[y] || {};
  return map[key] || "";
}

/* =========
   Storage / API
   ========= */
const API_URL = "https://cool-water-2111.ydf756vf8h.workers.dev";
const STORAGE_DRAFT = "ernest_plans_draft_v2";

async function loadSavedPlansFromServer(){
  try{
    const res = await fetch(API_URL);
    if(!res.ok) throw new Error("Failed to load saved plans");
    const data = await res.json();
    return Array.isArray(data) ? data : [];
  }catch(e){
    console.error(e);
    return [];
  }
}

async function saveSavedPlansToServer(data){
  try{
    const res = await fetch(API_URL, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(data)
    });
    if(!res.ok) throw new Error("Failed to save saved plans");
  }catch(e){
    console.error(e);
    alert("保存失败，服务器没有成功写入。");
  }
}

function loadDraft(){
  try{
    return JSON.parse(localStorage.getItem(STORAGE_DRAFT) || "{}");
  }catch(e){
    return {};
  }
}
function saveDraft(){
  localStorage.setItem(STORAGE_DRAFT, JSON.stringify(draftDates));
}

/* =========
   State
   ========= */
let draftDates = loadDraft();
let savedPlans = [];
let lastClickedKey = null;
let editingPlanId = null;

/* =========
   Helpers
   ========= */
const pad2 = (n) => String(n).padStart(2, "0");
function ymd(y,m,d){ return `${y}-${pad2(m)}-${pad2(d)}`; }
function parseYmd(s){
  const [y,m,d] = s.split("-").map(Number);
  return {y,m,d};
}
function formatDateChinese(key){
  const {y,m,d} = parseYmd(key);
  return `${y}/${pad2(m)}/${pad2(d)}`;
}
function daysInMonth(year, month){ return new Date(year, month, 0).getDate(); }
function firstDow(year, month){ return new Date(year, month-1, 1).getDay(); }
function escapeHtml(str){
  return String(str).replace(/[&<>"']/g, (m) => ({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  })[m]);
}
function newId(){
  return "p_" + Math.random().toString(36).slice(2,10) + Date.now().toString(36);
}
function sortedKeys(obj){ return Object.keys(obj).sort(); }
function inSameMonth(a,b){ return a.slice(0,7) === b.slice(0,7); }

/* =================
   UI references
   ================= */
const yearSelect = document.getElementById("yearSelect");
const monthSelect = document.getElementById("monthSelect");
const calendarEl = document.getElementById("calendar");
const todayBtn = document.getElementById("todayBtn");
const clearMonthBtn = document.getElementById("clearMonthBtn");
const clearDraftBtn = document.getElementById("clearDraftBtn");

const planNameInput = document.getElementById("planNameInput");
const planNoteInput = document.getElementById("planNoteInput");
const savePlanBtn = document.getElementById("savePlanBtn");
const cancelEditBtn = document.getElementById("cancelEditBtn");
const draftPreview = document.getElementById("draftPreview");
const draftHint = document.getElementById("draftHint");

const plansBody = document.getElementById("plansBody");
const summaryBody = document.getElementById("summaryBody");

/* ==========
   Init selects
   ========== */
const now = new Date();
const currentYear = now.getFullYear();
const currentMonth = now.getMonth()+1;

const startYear = currentYear - 3;
const endYear   = currentYear + 15;

for(let y=startYear; y<=endYear; y++){
  const opt = document.createElement("option");
  opt.value = y;
  opt.textContent = y;
  yearSelect.appendChild(opt);
}
const monthNames = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
for(let m=1; m<=12; m++){
  const opt = document.createElement("option");
  opt.value = m;
  opt.textContent = `${m} (${monthNames[m-1]})`;
  monthSelect.appendChild(opt);
}

yearSelect.value = currentYear;
monthSelect.value = currentMonth;

/* ==========
   Calendar render
   ========== */
const dows = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];

function renderCalendar(){
  calendarEl.innerHTML = "";

  for(const d of dows){
    const div = document.createElement("div");
    div.className = "dow";
    div.textContent = d;
    calendarEl.appendChild(div);
  }

  const y = Number(yearSelect.value);
  const m = Number(monthSelect.value);

  const total = daysInMonth(y,m);
  const first = firstDow(y,m);

  for(let i=0;i<first;i++){
    const blank = document.createElement("div");
    blank.className = "cell muted";
    blank.innerHTML = `<div class="date"><span></span><span></span></div>`;
    calendarEl.appendChild(blank);
  }

  for(let d=1; d<=total; d++){
    const key = ymd(y,m,d);
    const isSelected = !!draftDates[key];

    const dt = new Date(y, m-1, d);
    const ph = getPublicHolidayLabel(dt);

    const cell = document.createElement("div");
    cell.className = "cell" + (isSelected ? " selected" : "") + (ph ? " is-ph" : "");

    const rightBadge = ph ? `<span class="ph-tag">PH</span>` : (isSelected ? `<span class="tag">Draft</span>` : `<span></span>`);

    cell.innerHTML = `
      <div class="date">
        <span>${d}</span>
        ${rightBadge}
      </div>
      ${ph ? `<div class="ph-name">${escapeHtml(ph)}</div>` : `<div class="small">&nbsp;</div>`}
    `;

    cell.addEventListener("click", (e) => {
      if(e.shiftKey && lastClickedKey){
        const range = buildRange(lastClickedKey, key);
        range.forEach(k => { draftDates[k] = true; });
      }else{
        if(draftDates[key]) delete draftDates[key];
        else draftDates[key] = true;
        lastClickedKey = key;
      }
      saveDraft();
      updateDraftHint();
      renderCalendar();
      renderDraftPreview();
    });

    calendarEl.appendChild(cell);
  }
}

function buildRange(a, b){
  if(!inSameMonth(a,b)) return [b];
  const {y:ya, m:ma, d:da} = parseYmd(a);
  const {d:db} = parseYmd(b);
  const start = Math.min(da, db);
  const end = Math.max(da, db);
  const arr = [];
  for(let d=start; d<=end; d++){
    arr.push(ymd(ya, ma, d));
  }
  return arr;
}

/* ==========
   Draft preview / hint
   ========== */
function renderDraftPreview(){
  const keys = sortedKeys(draftDates);
  if(!keys.length){
    draftPreview.innerHTML = `Draft 日期：<span class="small">（还没选）</span>`;
    return;
  }
  const pills = keys.map(k => `<span class="pill">${formatDateChinese(k)}</span>`).join("");
  draftPreview.innerHTML = `Draft 日期（${keys.length} 天）：<div class="pills-wrap" style="margin-top:8px;">${pills}</div>`;
}

function updateDraftHint(){
  const base = `✅ 点击日期：加入/取消 Draft 假期。按住 <b>Shift</b>：连续选择区间（先点起点，再 Shift 点终点）。<br/>🟧 标记 <b>PH</b> 的为新加坡公假（Public Holiday）。`;
  if(editingPlanId){
    draftHint.innerHTML = base + `<br/><span class="small">✏️ 当前处于编辑模式：修改后点 <b>Update Plan</b> 保存。</span>`;
  }else{
    draftHint.innerHTML = base;
  }
}

/* ==========
   Saved plans render
   ========== */
function renderSavedPlans(){
  plansBody.innerHTML = "";

  if(!savedPlans.length){
    const tr = document.createElement("tr");
    tr.innerHTML = `<td colspan="4" class="small">还没有保存任何计划。先在左边 Draft 里选日期并 Save。</td>`;
    plansBody.appendChild(tr);
    return;
  }

  const sorted = savedPlans.slice().sort((a,b)=>{
    const aStart = (a.dates||[]).slice().sort()[0] || "9999-99-99";
    const bStart = (b.dates||[]).slice().sort()[0] || "9999-99-99";
    return aStart.localeCompare(bStart);
  });

  for(const p of sorted){
    const dates = (p.dates||[]).slice().sort();
    const pills = dates.map(k => `<span class="pill">${formatDateChinese(k)}</span>`).join("");
    const note = p.note ? escapeHtml(p.note) : `<span class="small">—</span>`;

    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td><b>${escapeHtml(p.name || "")}</b></td>
      <td>
        <div class="small">${dates.length} day(s)</div>

        <details class="plan-details">
          <summary>
            <span class="chev"></span>
            <span>Show dates</span>
          </summary>
          <div class="pills-wrap" style="margin-top:6px;">${pills}</div>
        </details>
      </td>
      <td>${note}</td>
      <td>
        <div class="right-actions">
          <button data-edit="${escapeHtml(p.id)}">Edit</button>
          <button class="danger" data-del="${escapeHtml(p.id)}">Delete</button>
        </div>
      </td>
    `;
    plansBody.appendChild(tr);

    const detailsEl = tr.querySelector("details.plan-details");
    const summaryText = detailsEl.querySelector("summary span:last-child");
    detailsEl.addEventListener("toggle", () => {
      summaryText.textContent = detailsEl.open ? "Hide dates" : "Show dates";
    });
  }

  plansBody.querySelectorAll("button[data-edit]").forEach(btn => {
    btn.addEventListener("click", () => {
      const id = btn.getAttribute("data-edit");
      const plan = savedPlans.find(p => p.id === id);
      if(!plan) return;

      editingPlanId = id;
      planNameInput.value = plan.name || "";
      planNoteInput.value = plan.note || "";

      draftDates = {};
      (plan.dates || []).forEach(d => draftDates[d] = true);
      saveDraft();

      savePlanBtn.textContent = "Update Plan";
      cancelEditBtn.style.display = "inline-block";

      const start = (plan.dates || []).slice().sort()[0];
      if(start){
        const {y,m} = parseYmd(start);
        yearSelect.value = y;
        monthSelect.value = m;
      }

      lastClickedKey = null;
      updateDraftHint();
      renderCalendar();
      renderDraftPreview();
      renderYearlySummary();
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  });

  plansBody.querySelectorAll("button[data-del]").forEach(btn => {
    btn.addEventListener("click", async () => {
      const id = btn.getAttribute("data-del");
      const plan = savedPlans.find(p => p.id === id);
      const name = plan?.name || "this plan";
      if(!confirm(`确定删除：${name} ？`)) return;

      savedPlans = savedPlans.filter(p => p.id !== id);
      await saveSavedPlansToServer(savedPlans);

      if(editingPlanId === id){
        exitEditMode(true);
      }

      renderSavedPlans();
      renderYearlySummary();
    });
  });
}

/* ==========
   Yearly summary
   ========== */
function renderYearlySummary(){
  summaryBody.innerHTML = "";

  if(!savedPlans.length){
    const tr = document.createElement("tr");
    tr.innerHTML = `<td colspan="3" class="small">还没有 Saved Plans。</td>`;
    summaryBody.appendChild(tr);
    return;
  }

  const byYear = {};

  for(const p of savedPlans){
    const dates = (p.dates || []).slice().sort();
    for(const d of dates){
      const y = d.slice(0,4);
      if(!byYear[y]) byYear[y] = [];
      let entry = byYear[y].find(x => x.id === p.id);
      if(!entry){
        entry = { id:p.id, name:p.name||"", note:p.note||"", dates:[] };
        byYear[y].push(entry);
      }
      entry.dates.push(d);
    }
  }

  const years = Object.keys(byYear).sort((a,b)=>Number(a)-Number(b));

  for(const y of years){
    const allDates = byYear[y].flatMap(p => p.dates);
    const days = allDates.length;

    const blocks = byYear[y]
      .slice()
      .sort((a,b)=>{
        const aStart = a.dates.slice().sort()[0] || "9999-99-99";
        const bStart = b.dates.slice().sort()[0] || "9999-99-99";
        return aStart.localeCompare(bStart);
      })
      .map(p=>{
        const pills = p.dates.slice().sort().map(k => `<span class="pill">${formatDateChinese(k)}</span>`).join("");
        const note = p.note ? `<div class="small">Note: ${escapeHtml(p.note)}</div>` : "";
        return `
          <div style="margin-bottom:10px;">
            <div><b>${escapeHtml(p.name)}</b> <span class="small">(${p.dates.length} day(s))</span></div>
            ${note}
            <div class="pills-wrap" style="margin-top:6px;">${pills}</div>
          </div>
        `;
      })
      .join("");

    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td><b>${y}</b></td>
      <td>${days}</td>
      <td>${blocks}</td>
    `;
    summaryBody.appendChild(tr);
  }
}

/* ==========
   Edit mode helpers
   ========== */
function exitEditMode(clearDraft){
  editingPlanId = null;
  savePlanBtn.textContent = "Save Plan";
  cancelEditBtn.style.display = "none";
  if(clearDraft){
    draftDates = {};
    saveDraft();
    planNameInput.value = "";
    planNoteInput.value = "";
    lastClickedKey = null;
  }
  updateDraftHint();
  renderCalendar();
  renderDraftPreview();
}

/* ==========
   Buttons events
   ========== */
todayBtn.addEventListener("click", () => {
  yearSelect.value = currentYear;
  monthSelect.value = currentMonth;
  renderCalendar();
});

yearSelect.addEventListener("change", () => renderCalendar());
monthSelect.addEventListener("change", () => renderCalendar());

clearMonthBtn.addEventListener("click", () => {
  const y = Number(yearSelect.value);
  const m = Number(monthSelect.value);
  const prefix = `${y}-${pad2(m)}-`;
  Object.keys(draftDates).forEach(k => {
    if(k.startsWith(prefix)) delete draftDates[k];
  });
  saveDraft();
  renderCalendar();
  renderDraftPreview();
});

clearDraftBtn.addEventListener("click", () => {
  if(!confirm("确定清空 Draft（所有月份）吗？Saved Plans 不会受影响。")) return;
  draftDates = {};
  saveDraft();
  lastClickedKey = null;
  renderCalendar();
  renderDraftPreview();
});

cancelEditBtn.addEventListener("click", () => {
  exitEditMode(true);
});

savePlanBtn.addEventListener("click", async () => {
  const name = planNameInput.value.trim();
  if(!name){
    alert("请先填写 Plan Name（例如：Jordan Trip）");
    planNameInput.focus();
    return;
  }

  const dates = sortedKeys(draftDates);
  if(!dates.length){
    alert("你还没选任何日期。先在日历里点选（可 Shift 连选）。");
    return;
  }

  const note = planNoteInput.value.trim();

  if(editingPlanId){
    const idx = savedPlans.findIndex(p => p.id === editingPlanId);
    if(idx === -1){
      alert("找不到要编辑的 Plan（可能已被删除）。");
      exitEditMode(true);
      return;
    }
    savedPlans[idx] = { ...savedPlans[idx], name, note, dates };
    await saveSavedPlansToServer(savedPlans);

    exitEditMode(true);
    renderSavedPlans();
    renderYearlySummary();
    alert("已更新 ✅");
    return;
  }

  const plan = { id:newId(), name, note, dates };
  savedPlans.push(plan);
  await saveSavedPlansToServer(savedPlans);

  draftDates = {};
  saveDraft();
  lastClickedKey = null;
  planNameInput.value = "";
  planNoteInput.value = "";

  updateDraftHint();
  renderCalendar();
  renderDraftPreview();
  renderSavedPlans();
  renderYearlySummary();
  alert("已保存 ✅ 现在可以开始选下一个计划了。");
});

/* ==========
   First render
   ========== */
async function initPage(){
  savedPlans = await loadSavedPlansFromServer();
  updateDraftHint();
  renderCalendar();
  renderDraftPreview();
  renderSavedPlans();
  renderYearlySummary();
}

initPage();
</script>

